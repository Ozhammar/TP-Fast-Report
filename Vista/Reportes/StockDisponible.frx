<Report ScriptLanguage="CSharp" DoublePass="true" ReportInfo.Name="Stock disponible" ReportInfo.Description="Stock y valorización por prenda, agrupado por categoría (en rojo: 5 unidades o menos)" ReportInfo.Created="10/26/2026 17:00:00" ReportInfo.Modified="10/26/2026 17:00:00" ReportInfo.CreatorVersion="2027.1.0.0">
